# Settings for the cli container (docker-compose.yml reads cli.env).
# Copy to cli.env and fill in. cli.env holds secrets: never commit it.
# The database URL is set in docker-compose.yml (PH_SWITCHBOARD_DATABASE_URL).

# --- Required -----------------------------------------------------------

# Encrypts the workflow connections' secrets (OAuth tokens) in the database.
# 64 hex characters; the switchboard refuses to start on Postgres without it,
# and refuses a different key later. Generate once:  openssl rand -hex 32
PH_WORKFLOWS_SECRETS_MASTER_KEY=

# The public address people open (scheme and host, no path), e.g.
# https://sektar.example.com. The switchboard builds absolute links from it,
# such as the OAuth sign-in callback:
#   <PUBLIC_URL>/api/@powerhousedao/workflow/oauth/callback
# which must be an authorized redirect URI of the Google web client.
PUBLIC_URL=http://localhost:3000

# --- Access -------------------------------------------------------------

# Sign-in with Renown; only listed admin addresses manage the instance.
AUTH_ENABLED=true
REQUIRE_AUTHENTICATED_CALLER=true
RESOLVE_CALLER_IDENTITY=true
INSPECTION_ADMIN_ENABLED=true
# Comma-separated Ethereum addresses. The assistant on the welcome page is for
# these admins only; its OpenRouter key is set there, and stored under
# PH_WORKFLOWS_SECRETS_MASTER_KEY like the workflows' secrets.
ADMINS=

# --- Resources ----------------------------------------------------------

# Heap for the host process (switchboard and Connect's server share it)
NODE_OPTIONS=--max-old-space-size=4096
# Heap for each workflow worker process
PH_WORKFLOWS_WORKER_MEMORY_MB=2048

# --- Optional -----------------------------------------------------------

# Signs attachment download links; unset, filesystem downloads are refused.
# Generate once:  openssl rand -hex 32
# PH_ATTACHMENT_URL_SIGNING_SECRET=
# LOG_LEVEL=info
